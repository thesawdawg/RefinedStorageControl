<configs>
  <!-- Storage disks (DISK-01). Placeholder model: vanilla electrical parts;
       icons rendered by Tools/Art/rsc_art.py. Stacknumber 1: each disk carries its own identity in item
       metadata (rsc.disk / rsc.world), so disks must never merge.
       Recipes: recipes.xml; Wiring 101 gates (55/60/70/80/90/100): progression.xml. -->
  <append xpath="/items">
    <item name="rscDisk1k">
      <property name="Extends" value="resourceElectricParts" />
      <property name="CustomIcon" value="rscDisk1k" />
      <property name="DescriptionKey" value="rscDiskDesc" />
      <property name="Tags" value="rscDisk" />
      <property name="Group" value="Science" />
      <property name="Stacknumber" value="1" />
      <property name="EconomicValue" value="200" />
      <property name="CreativeMode" value="Player" />
      <property name="RscDiskTier" value="K1" />
      <property name="UnlockedBy" value="craftingElectrician" />
    </item>
    <item name="rscDisk10k">
      <property name="Extends" value="rscDisk1k" />
      <property name="CustomIcon" value="rscDisk10k" />
      <property name="EconomicValue" value="500" />
      <property name="RscDiskTier" value="K10" />
    </item>
    <item name="rscDisk100k">
      <property name="Extends" value="rscDisk1k" />
      <property name="CustomIcon" value="rscDisk100k" />
      <property name="EconomicValue" value="1200" />
      <property name="RscDiskTier" value="K100" />
    </item>
    <item name="rscDisk250k">
      <property name="Extends" value="rscDisk1k" />
      <property name="CustomIcon" value="rscDisk250k" />
      <property name="EconomicValue" value="2500" />
      <property name="RscDiskTier" value="K250" />
    </item>
    <item name="rscDisk500k">
      <property name="Extends" value="rscDisk1k" />
      <property name="CustomIcon" value="rscDisk500k" />
      <property name="EconomicValue" value="5000" />
      <property name="RscDiskTier" value="K500" />
    </item>
    <item name="rscDisk1m">
      <property name="Extends" value="rscDisk1k" />
      <property name="CustomIcon" value="rscDisk1m" />
      <property name="EconomicValue" value="10000" />
      <property name="RscDiskTier" value="M1" />
    </item>
  </append>
</configs>
