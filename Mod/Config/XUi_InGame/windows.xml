<configs>
  <append xpath="/windows">

    <!-- Storage terminal: network items (top) and the player's backpack (bottom). -->
    <window name="windowRscTerminal" width="620" height="792" pos="-310,396" anchor="Center" depth="15" cursor_area="true"
            controller="RefinedStorageControl.Game.UI.RscTerminal, RefinedStorageControl">
      <rect name="header" height="43" depth="1">
        <headerbg />
        <sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_loot_sack" />
        <label style="header.name" text="{title}" width="560" />
      </rect>

      <rect name="content" pos="0,-46" height="746" depth="1">
        <sprite depth="0" name="backgroundMain" sprite="menu_empty3px" width="620" height="746" color="[black]" type="sliced" fillcenter="false" />
        <sprite depth="0" color="[darkGrey]" type="sliced" width="620" height="746" />

        <rect name="toolbar" pos="8,-6" height="36" depth="2">
          <sprite depth="2" style="icon30px" pos="12,-18" sprite="ui_game_symbol_search" pivot="center" />
          <textfield name="search" depth="3" pos="28,-3" width="210" height="30" search_field="true" clear_button="true" />
          <simplebutton name="btnDepositMatching" depth="3" pos="248,-18" width="170" height="32" font_size="22" caption_key="rscDepositMatching" />
          <simplebutton name="btnDepositAll" depth="3" pos="424,-18" width="180" height="32" font_size="22" caption_key="rscDepositAll" />
        </rect>

        <rect name="viewbar" pos="8,-46" height="36" depth="2">
          <simplebutton name="btnCategory" depth="3" pos="0,-18" width="220" height="32" font_size="22" caption="{category}" />
          <simplebutton name="btnSort" depth="3" pos="226,-18" width="170" height="32" font_size="22" caption="{sortmode}" />
          <simplebutton name="btnFavorites" depth="3" pos="402,-18" width="202" height="32" font_size="22" caption="{favmode}" />
        </rect>

        <grid name="netGrid" pos="10,-88" rows="4" cols="10" cell_width="60" cell_height="60" repeat_content="true" depth="3">
          <rect controller="RefinedStorageControl.Game.UI.RscCell, RefinedStorageControl" width="58" height="58" on_press="true" tooltip="{tooltip}">
            <sprite depth="3" name="border" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" width="58" height="58" />
            <sprite depth="2" name="bg" sprite="menu_empty" color="{bgcolor}" type="sliced" pos="1,-1" width="56" height="56" />
            <sprite depth="4" name="icon" atlas="ItemIconAtlas" sprite="{itemicon}" color="{itemiconcolor}" pos="29,-28" width="46" height="46" pivot="center" visible="{hasitem}" foregroundlayer="true" />
            <sprite depth="5" name="quality" sprite="menu_empty" color="{qualitycolor}" type="sliced" pos="3,-52" width="52" height="4" visible="{hasquality}" />
            <label depth="6" name="count" text="{itemcount}" pos="2,-32" width="54" height="20" justify="right" font_size="20" effect="outline" />
            <sprite depth="6" name="favorite" sprite="server_favorite" pos="2,-2" width="18" height="18" foregroundlayer="true" visible="{isfavorite}" />
          </rect>
        </grid>

        <rect name="netPaging" pos="8,-332" height="32" depth="3">
          <simplebutton name="btnNetPrev" depth="3" pos="0,-16" width="40" height="30" font_size="24" caption="&lt;" />
          <label depth="3" pos="48,-4" width="300" height="26" font_size="22" text="{netpage}" />
          <simplebutton name="btnNetNext" depth="3" pos="562,-16" width="40" height="30" font_size="24" caption="&gt;" />
        </rect>

        <label depth="3" pos="10,-370" width="400" height="26" font_size="24" text_key="rscBackpack" />

        <grid name="bagGrid" pos="10,-400" rows="5" cols="10" cell_width="60" cell_height="60" repeat_content="true" depth="3">
          <rect controller="RefinedStorageControl.Game.UI.RscCell, RefinedStorageControl" width="58" height="58" on_press="true" tooltip="{tooltip}">
            <sprite depth="3" name="border" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" width="58" height="58" />
            <sprite depth="2" name="bg" sprite="menu_empty" color="{bgcolor}" type="sliced" pos="1,-1" width="56" height="56" />
            <sprite depth="4" name="icon" atlas="ItemIconAtlas" sprite="{itemicon}" color="{itemiconcolor}" pos="29,-28" width="46" height="46" pivot="center" visible="{hasitem}" foregroundlayer="true" />
            <sprite depth="5" name="quality" sprite="menu_empty" color="{qualitycolor}" type="sliced" pos="3,-52" width="52" height="4" visible="{hasquality}" />
            <label depth="6" name="count" text="{itemcount}" pos="2,-32" width="54" height="20" justify="right" font_size="20" effect="outline" />
            <sprite depth="6" name="lock" sprite="ui_game_symbol_lock" pos="40,-2" width="16" height="16" color="[lightGrey]" visible="{locked}" />
          </rect>
        </grid>

        <rect name="bagPaging" pos="8,-704" height="32" depth="3">
          <simplebutton name="btnBagPrev" depth="3" pos="0,-16" width="40" height="30" font_size="24" caption="&lt;" />
          <label depth="3" pos="48,-4" width="80" height="26" font_size="22" text="{bagpage}" />
          <label depth="3" pos="136,-4" width="420" height="26" font_size="22" text="{status}" color="[lightGrey]" />
          <simplebutton name="btnBagNext" depth="3" pos="562,-16" width="40" height="30" font_size="24" caption="&gt;" />
        </rect>
      </rect>
    </window>

    <!-- Interface settings: priority and deposit filter. -->
    <window name="windowRscInterface" width="520" height="360" pos="-260,180" anchor="Center" depth="15" cursor_area="true"
            controller="RefinedStorageControl.Game.UI.RscInterface, RefinedStorageControl">
      <rect name="header" height="43" depth="1">
        <headerbg />
        <sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_wrench" />
        <label style="header.name" text="{title}" width="460" />
      </rect>

      <rect name="content" pos="0,-46" height="314" depth="1">
        <sprite depth="0" name="backgroundMain" sprite="menu_empty3px" width="520" height="314" color="[black]" type="sliced" fillcenter="false" />
        <sprite depth="0" color="[darkGrey]" type="sliced" width="520" height="314" />

        <label depth="3" pos="12,-10" width="496" height="26" font_size="22" text="{containers}" color="[lightGrey]" />

        <label depth="3" pos="12,-46" width="200" height="30" font_size="26" text_key="rscPriority" />
        <simplebutton name="btnMinus10" depth="3" pos="160,-61" width="56" height="30" font_size="22" caption="-10" />
        <simplebutton name="btnMinus1" depth="3" pos="220,-61" width="44" height="30" font_size="22" caption="-1" />
        <label depth="3" pos="268,-46" width="60" height="30" font_size="28" justify="center" text="{priority}" />
        <simplebutton name="btnPlus1" depth="3" pos="332,-61" width="44" height="30" font_size="22" caption="+1" />
        <simplebutton name="btnPlus10" depth="3" pos="380,-61" width="56" height="30" font_size="22" caption="+10" />
        <label depth="3" pos="12,-82" width="496" height="22" font_size="18" text_key="rscPriorityHint" color="[lightGrey]" />

        <label depth="3" pos="12,-118" width="140" height="30" font_size="26" text_key="rscFilter" />
        <simplebutton name="btnMode" depth="3" pos="160,-133" width="276" height="30" font_size="22" caption="{filtermode}" />
        <label depth="3" pos="12,-158" width="496" height="60" font_size="20" text="{filteritems}" />
        <simplebutton name="btnAddHeld" depth="3" pos="12,-238" width="240" height="32" font_size="22" caption_key="rscAddHeld" />
        <simplebutton name="btnClear" depth="3" pos="262,-238" width="174" height="32" font_size="22" caption_key="rscClearFilter" />

        <label depth="3" pos="12,-270" width="496" height="26" font_size="20" text="{status}" color="[lightGrey]" />
      </rect>
    </window>

    <!-- Drive cabinet: six disk slots, the selected disk's access list, and the backpack. -->
    <window name="windowRscCabinet" width="620" height="746" pos="-310,373" anchor="Center" depth="15" cursor_area="true"
            controller="RefinedStorageControl.Game.UI.RscCabinet, RefinedStorageControl">
      <rect name="header" height="43" depth="1">
        <headerbg />
        <sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_electric_power" />
        <label style="header.name" text="{title}" width="560" />
      </rect>

      <rect name="content" pos="0,-46" height="700" depth="1">
        <sprite depth="0" name="backgroundMain" sprite="menu_empty3px" width="620" height="700" color="[black]" type="sliced" fillcenter="false" />
        <sprite depth="0" color="[darkGrey]" type="sliced" width="620" height="700" />

        <grid name="cabGrid" pos="10,-8" rows="1" cols="6" cell_width="60" cell_height="60" repeat_content="true" depth="3">
          <rect controller="RefinedStorageControl.Game.UI.RscCell, RefinedStorageControl" width="58" height="58" on_press="true" tooltip="{tooltip}">
            <sprite depth="3" name="border" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" width="58" height="58" />
            <sprite depth="2" name="bg" sprite="menu_empty" color="{bgcolor}" type="sliced" pos="1,-1" width="56" height="56" />
            <sprite depth="4" name="icon" atlas="ItemIconAtlas" sprite="{itemicon}" color="{itemiconcolor}" pos="29,-28" width="46" height="46" pivot="center" visible="{hasitem}" foregroundlayer="true" />
            <sprite depth="5" name="quality" sprite="menu_empty" color="{qualitycolor}" type="sliced" pos="3,-52" width="52" height="4" visible="{hasquality}" />
            <label depth="6" name="count" text="{itemcount}" pos="2,-32" width="54" height="20" justify="right" font_size="20" effect="outline" />
            <sprite depth="6" name="selected" sprite="menu_empty3px" color="[white]" type="sliced" fillcenter="false" width="58" height="58" visible="{isfavorite}" />
          </rect>
        </grid>
        <simplebutton name="btnRemove" depth="3" pos="384,-38" width="220" height="32" font_size="22" caption_key="rscRemoveDisk" />

        <label depth="3" pos="12,-74" width="596" height="50" font_size="20" text="{slotinfo}" />

        <label depth="3" pos="12,-130" width="300" height="26" font_size="24" text_key="rscAccess" />
        <rect name="entryRow" pos="8,-160" height="32" depth="3">
          <simplebutton name="btnEntryPrev" depth="3" pos="0,-16" width="40" height="30" font_size="24" caption="&lt;" visible="{canconfigure}" />
          <label depth="3" pos="48,-3" width="508" height="26" font_size="22" justify="center" text="{entryline}" />
          <simplebutton name="btnEntryNext" depth="3" pos="564,-16" width="40" height="30" font_size="24" caption="&gt;" visible="{canconfigure}" />
        </rect>
        <rect name="permRow" pos="8,-198" height="32" depth="3">
          <simplebutton name="btnPermDeposit" depth="3" pos="0,-16" width="146" height="30" font_size="20" caption="{permdeposit}" visible="{hasentry}" />
          <simplebutton name="btnPermWithdraw" depth="3" pos="152,-16" width="146" height="30" font_size="20" caption="{permwithdraw}" visible="{hasentry}" />
          <simplebutton name="btnPermCraft" depth="3" pos="304,-16" width="146" height="30" font_size="20" caption="{permcraft}" visible="{hasentry}" />
          <simplebutton name="btnPermConfigure" depth="3" pos="456,-16" width="148" height="30" font_size="20" caption="{permconfigure}" visible="{hasentry}" />
        </rect>
        <rect name="entryActions" pos="8,-236" height="32" depth="3">
          <simplebutton name="btnEntryRemove" depth="3" pos="0,-16" width="220" height="30" font_size="20" caption_key="rscRemoveFromList" visible="{hasentry}" />
          <simplebutton name="btnMakeOwner" depth="3" pos="228,-16" width="220" height="30" font_size="20" caption_key="rscMakeOwner" visible="{isowner}" />
        </rect>
        <rect name="addRow" pos="8,-274" height="32" depth="3">
          <label depth="3" pos="0,-3" width="120" height="26" font_size="22" text_key="rscAddPlayer" visible="{canconfigure}" />
          <simplebutton name="btnCandPrev" depth="3" pos="124,-16" width="40" height="30" font_size="24" caption="&lt;" visible="{canconfigure}" />
          <label depth="3" pos="170,-3" width="270" height="26" font_size="22" justify="center" text="{candidate}" visible="{canconfigure}" />
          <simplebutton name="btnCandNext" depth="3" pos="446,-16" width="40" height="30" font_size="24" caption="&gt;" visible="{canconfigure}" />
          <simplebutton name="btnAdd" depth="3" pos="494,-16" width="110" height="30" font_size="22" caption_key="rscAdd" visible="{canconfigure}" />
        </rect>

        <label depth="3" pos="10,-318" width="500" height="26" font_size="24" text_key="rscBackpackDisks" />
        <grid name="bagGrid" pos="10,-348" rows="5" cols="10" cell_width="60" cell_height="60" repeat_content="true" depth="3">
          <rect controller="RefinedStorageControl.Game.UI.RscCell, RefinedStorageControl" width="58" height="58" on_press="true" tooltip="{tooltip}">
            <sprite depth="3" name="border" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" width="58" height="58" />
            <sprite depth="2" name="bg" sprite="menu_empty" color="{bgcolor}" type="sliced" pos="1,-1" width="56" height="56" />
            <sprite depth="4" name="icon" atlas="ItemIconAtlas" sprite="{itemicon}" color="{itemiconcolor}" pos="29,-28" width="46" height="46" pivot="center" visible="{hasitem}" foregroundlayer="true" />
            <sprite depth="5" name="quality" sprite="menu_empty" color="{qualitycolor}" type="sliced" pos="3,-52" width="52" height="4" visible="{hasquality}" />
            <label depth="6" name="count" text="{itemcount}" pos="2,-32" width="54" height="20" justify="right" font_size="20" effect="outline" />
            <sprite depth="6" name="lock" sprite="ui_game_symbol_lock" pos="40,-2" width="16" height="16" color="[lightGrey]" visible="{locked}" />
          </rect>
        </grid>
        <rect name="bagPaging" pos="8,-656" height="32" depth="3">
          <simplebutton name="btnBagPrev" depth="3" pos="0,-16" width="40" height="30" font_size="24" caption="&lt;" />
          <label depth="3" pos="48,-4" width="80" height="26" font_size="22" text="{bagpage}" />
          <label depth="3" pos="136,-4" width="420" height="26" font_size="22" text="{status}" color="[lightGrey]" />
          <simplebutton name="btnBagNext" depth="3" pos="562,-16" width="40" height="30" font_size="24" caption="&gt;" />
        </rect>
      </rect>
    </window>

  </append>
</configs>
