<?xml version="1.0" encoding="UTF-8"?>
<!-- Refined Storage Control settings. Read when the game starts; restart to
     apply changes. In co-op the host's file decides every rule. A value that
     is missing, misspelled or out of range falls back to its default and is
     reported in the game log ("[RSC] settings: ...").

     Block power use is set in Config/blocks.xml (RequiredPower), recipes in
     Config/recipes.xml and unlock levels in Config/progression.xml. -->
<settings>
  <!-- Stack transfers per second per network (1-100 / 1-1000). One transfer
       moves up to one full stack from one slot. Crafting inputs and outputs
       count too. -->
  <setting name="SimpleTransfersPerSecond" value="2" />
  <setting name="AdvancedTransfersPerSecond" value="20" />

  <!-- Chance (0-1) that each disk survives when its drive cabinet is
       destroyed, and that a destroyed interface or cabinet loses its deposit
       filter (its priority is always kept). -->
  <setting name="DiskSurvivalChance" value="0.5" />
  <setting name="FilterLossChance" value="0.5" />

  <!-- Terminal crafting: cancel window before anything is taken (1-60 s),
       and the largest amount one request may ask for (1-9999). -->
  <setting name="CraftCountdownSeconds" value="5" />
  <setting name="MaxCraftsPerRequest" value="999" />

  <!-- How long items RSC drops on the ground last (60-86400 s). -->
  <setting name="DropLifetimeSeconds" value="3600" />

  <!-- Journal (rsc journal, <save>/RefinedStorageControl/journal.log): lines
       kept in memory (100-100000) and file size before it rotates (64-65536 KB). -->
  <setting name="JournalLines" value="2000" />
  <setting name="JournalFileKb" value="1024" />
</settings>
